# =============================================================================
# AI Customer Support Widget with RAG & Human-in-the-Loop (HITL)
# Copy this file to `.env` and fill in your API key before starting the server.
# =============================================================================

# --- LLM Provider Configuration ---
# Supported values: "openai" or "gemini"
LLM_PROVIDER=openai

# API key for the selected LLM_PROVIDER (OpenAI API key or Google Gemini API key)
LLM_API_KEY=your_api_key_here

# Model overrides (defaults shown below)
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Storage ---
# Path to the single-file SQLite database (stores sessions, messages, docs & vectors)
DATABASE_PATH=./app.db

# --- Security & Access Control ---
# Comma-separated list of origins allowed to embed the widget and connect via WebSocket.
# Example: https://yourcompany.com,https://app.yourcompany.com
# Use "*" ONLY for local development.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional admin/agent key for protecting /dashboard agent actions and Knowledge Base endpoints.
# Leave blank for zero-config local evaluation; set a strong random string in production.
AGENT_API_KEY=

# Basic IP-based rate limiting for visitor chat messages
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Set to "true" ONLY when running behind a trusted reverse proxy (Nginx, Caddy, Cloudflare)
# that overwrites X-Forwarded-For with the verified client IP.
TRUST_PROXY_HEADERS=false

# --- RAG Pipeline Tuning ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35

# --- Server ---
HOST=0.0.0.0
PORT=8000
